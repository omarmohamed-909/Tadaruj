PORT=8080
TRUST_PROXY_HOPS=0
# Manual payment approval needs a replica set (or MongoDB Atlas), not standalone MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/tadaruj?replicaSet=rs0
SECRET_KEY=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
# Optional Google Identity Services web client. Public ID only; no client secret needed.
GOOGLE_CLIENT_ID=
# Include every exact frontend origin used for Google login (comma-separated).
FRONTEND_URLS=http://localhost:5173,http://localhost:5188
ALLOW_DEV_RESET_LINKS=false
ALLOW_DEV_VERIFICATION_LINKS=false

# Needed for uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: only for verifying legacy Stripe checkout sessions; new orders use WhatsApp.
STRIPE_SECRET_KEY=
WEBHOOK_ENDPOINT_SECRET=

# Resend: server-side only. Use a Sending Access key scoped to your own domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
EMAIL_DELIVERY_ENABLED=true
# Without a verified domain, use Tadaruj <onboarding@resend.dev> and your Resend
# account owner's email here. This mode cannot send to other students.
RESEND_TEST_RECIPIENT=
